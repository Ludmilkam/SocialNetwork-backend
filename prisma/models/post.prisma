model Post {
  id       Int     @id @default(autoincrement())
  title    String
  subject  String
  tags     Tag[] @relation("post_app_post_tags")
  body     String
  images    Image[] @relation("post_app_post_images")
  author   User    @relation(fields: [authorId], references: [id])
  authorId Int
  views User[]  @relation("post_app_post_views")
  likes  User[]  @relation("post_app_post_likes")
  links     Link[]

  @@map("post_app_post")
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String
  posts Post[]
  @@map("post_app_tag")
}

model Link {
  id     Int    @id @default(autoincrement())
  url    String
  postId Int
  post   Post   @relation(fields: [postId], references: [id])
  @@map("post_app_link")
}
