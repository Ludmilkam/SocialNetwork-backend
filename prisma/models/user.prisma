model User {
  id           Int       @id @default(autoincrement())
  password     String
  last_login   DateTime?
  is_superuser Boolean   @default(false)
  username     String    @unique
  first_name   String?
  last_name    String?
  email        String @unique
  is_staff     Boolean   @default(false)
  is_active    Boolean   @default(true)
  date_joined  DateTime  @default(now())

  profile     Profile?
  ChatMessage ChatMessage[]
  Post        Post[]
  PostView    PostView[]
  PostLike    PostLike[]

  @@map("auth_user")
}

model Profile {
  id            Int       @id @default(autoincrement())
  user_id       Int       @unique
  date_of_birth DateTime?
  signature     String?

  // Relations
  user                        User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chat_group_members          ChatGroupMember[]
  administered_groups         ChatGroup[]        @relation("chat_group_admin")
  avatars                     Avatar[]
  chat_messages               ChatMessage[]
  posts                       Post[]
  post_views                  PostView[]
  post_likes                  PostLike[]
  friendship_sent_request     Friendship[]       @relation("friendship_sent_request")
  friendship_accepted_request Friendship[]       @relation("friendship_accepted_request")
  albums Album[]

  @@map("user_app_profile")
}

model Avatar {
  id         Int     @id @default(autoincrement())
  image      String 
  profile_id Int
  active     Boolean @default(true)
  shown      Boolean @default(true)

  // Relations
  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@map("user_app_avatar")
}

model Friendship {
  id          Int     @id @default(autoincrement())
  profile1_id Int
  profile2_id Int
  accepted    Boolean @default(false)

  // Relations
  profile1 Profile @relation("friendship_sent_request", fields: [profile1_id], references: [id], onDelete: Cascade)
  profile2 Profile @relation("friendship_accepted_request", fields: [profile2_id], references: [id], onDelete: Cascade)

  @@unique([profile1_id, profile2_id])
  @@map("user_app_friendship")
}

model VerificationCode {
  id         Int      @id @default(autoincrement())
  username   String
  code       String
  created_at DateTime @default(now())

  @@map("user_app_verificationcode")
}
