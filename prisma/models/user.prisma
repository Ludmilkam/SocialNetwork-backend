enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id          Int      @id @default(autoincrement())
  username    String?
  email       String   @unique
  aboutMe     String?
  firstName   String?
  lastName    String?
  birthDate   DateTime?
  isOnline    Boolean  @default(true)
  avatarUrl   String?
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
