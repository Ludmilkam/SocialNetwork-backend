enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  email       String   @unique
  phoneNumber String
  aboutMe     String?
  firstName   String
  lastName    String
  isOnline    Boolean  @default(true)
  avatarUrl   String?
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
